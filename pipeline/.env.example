# Copy to .env and fill in. Real shell environment variables override this file.
GOOGLE_API_KEY=
PARALLEL_API_KEY=
YOUTUBE_API_KEY=

# Required: the pipeline writes to Supabase (local: `supabase status`).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PIPELINE_SHARED_SECRET=devsecret

# Keep first live runs cheap (default cap is 3.0)
CLAIMCHECK_MAX_COST_USD=0.50
# CLAIMCHECK_FAST_MODEL=
# CLAIMCHECK_VIDEO_PROCESSING=agentic   # or static (fixed low-fps fallback)

# Sources: one Parallel search per claim; results shown as returned (top N, Parallel's order)
# CLAIMCHECK_SOURCES_PER_CLAIM=5
# CLAIMCHECK_SOURCES_SEARCH_MODE=fast     # turbo | fast | basic | advanced
# Searches per "Check sources for all claims" press (press again for the rest)
# CLAIMCHECK_SOURCES_ALL_MAX_SEARCHES=25
# Look up sources for every claim right after a video is analysed (off by default; ~$0.005 per claim)
# CLAIMCHECK_AUTO_SOURCES=0
# Prices per 1M tokens if they change: {"model-substring": [input, output]}
# CLAIMCHECK_PRICES_JSON=


# How long the extractor thinks before it writes the first statement: minimal | low | medium | high | default
# Lower = statements appear sooner. Default is low.
# CLAIMCHECK_EXTRACT_THINKING=low
