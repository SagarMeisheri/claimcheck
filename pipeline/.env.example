# Copy to .env and fill in. Real shell environment variables override this file.
GOOGLE_API_KEY=
PARALLEL_API_KEY=
YOUTUBE_API_KEY=

# Leave SUPABASE_* empty to use the in-memory store (no database).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PIPELINE_SHARED_SECRET=devsecret

# Keep first live runs cheap (default cap is 3.0)
CLAIMCHECK_MAX_COST_USD=0.50
# CLAIMCHECK_FAST_MODEL=
# CLAIMCHECK_JUDGE_MODEL=
# CLAIMCHECK_VIDEO_PROCESSING=agentic   # or static (fixed low-fps fallback)

# Dev: ignore the triage worthiness threshold (never-check share gate still applies)
# CLAIMCHECK_SKIP_WORTHINESS=1

# Skip the video if fewer than N statements (any type) are found after extraction (0 = off)
# CLAIMCHECK_MIN_STATEMENTS=5

# Factual claims verified automatically per video (default: policy.yaml claims.auto_verify = 4).
# The rest are verified when a viewer presses Verify, within the same per-video cost cap.
# CLAIMCHECK_AUTO_VERIFY=4
