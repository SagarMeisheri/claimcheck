# Copy to .env and fill in. Real shell environment variables override this file.
GOOGLE_API_KEY=
PARALLEL_API_KEY=
YOUTUBE_API_KEY=

# Required: the pipeline writes to Supabase (local: `supabase status`).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PIPELINE_SHARED_SECRET=devsecret

# Keep first live runs cheap (default cap is 3.0)
CLAIMCHECK_MAX_COST_USD=0.50
# CLAIMCHECK_FAST_MODEL=
# CLAIMCHECK_VIDEO_PROCESSING=agentic   # or static (fixed low-fps fallback)

# Sources: one Parallel search per claim; results shown as returned (top N, Parallel's order)
# CLAIMCHECK_SOURCES_PER_CLAIM=5
# CLAIMCHECK_SOURCES_SEARCH_MODE=fast     # turbo | fast | basic | advanced
# Searches per "Check sources for all claims" press (press again for the rest)
# CLAIMCHECK_SOURCES_ALL_MAX_SEARCHES=75
# Sources summary + match (Gemini 3.8 Flash); 0 turns it off
# CLAIMCHECK_SUMMARIZE_SOURCES=1
# CLAIMCHECK_SUMMARY_MODEL=gemini-3.5-flash-lite
# CLAIMCHECK_SUMMARY_THINKING=low
# Look up sources for every claim right after a video is analysed (off by default; ~$0.005 per claim)
# Look up sources by themselves, so nobody has to press "Check sources":
#   CLAIMCHECK_AUTO_SOURCES=1            after the whole video is read
#   CLAIMCHECK_AUTO_SOURCES_AS_FOUND=1   also start each answer's lookup as soon as it is saved (implies the above)
# CLAIMCHECK_AUTO_SOURCES=0
# CLAIMCHECK_AUTO_SOURCES_AS_FOUND=0
# CLAIMCHECK_AUTO_SOURCES_STREAM_BUDGET_USD=0.5
# Source triage (ADK ClassifierNode): skip / related / data / contested per statement. Off = one search each.
# CLAIMCHECK_TRIAGE_SOURCES=1
# CLAIMCHECK_TRIAGE_MODEL=gemini-3.5-flash-lite
# Second search (data / contested only): official data, other figures, other viewpoints.
# CLAIMCHECK_COUNTER_SEARCH=1
# Speaker profiles: one web search + one model call per new named speaker (reused across videos).
# CLAIMCHECK_PROFILE_SPEAKERS=1
# CLAIMCHECK_MAX_SPEAKER_PROFILES=6
# CLAIMCHECK_PROFILE_MODEL=gemini-3.5-flash-lite
# Where searches are geo-targeted when the channel isn't a known creator (ISO country code).
# CLAIMCHECK_SEARCH_LOCATION=in
# Prices per 1M tokens if they change: {"model-substring": [input, output]}
# CLAIMCHECK_PRICES_JSON=


# How long the extractor thinks before it writes the first statement: minimal | low | medium | high | default
# Lower = statements appear sooner. Default is low.
# CLAIMCHECK_EXTRACT_THINKING=low

# A video's answers are looked up together (agents/batch.py): answers classified several to a call, one planner call for all of them,
# searches shared between answers about the same subject. CLAIMCHECK_BATCH_LOOKUPS=0 goes back to one lookup per answer (and lookups that
# start while the extractor is still writing, with CLAIMCHECK_AUTO_SOURCES_AS_FOUND=1).
# CLAIMCHECK_BATCH_LOOKUPS=1
# CLAIMCHECK_TAG_BATCH=5            answers by one speaker per classifier call
# CLAIMCHECK_PLAN_CHUNK=40          answers per planner call
# CLAIMCHECK_SEARCH_CACHE_TTL_S=3600  reuse a search for the same queries this long (this process only; 0 = off)
