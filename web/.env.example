# Local Supabase (supabase start) or your project. These are required; there is no demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pipeline service (Cloud Run)
PIPELINE_URL=http://localhost:8080
PIPELINE_SHARED_SECRET=
# Salt for hashing submitter IPs (rate limit: 5 submissions per day)
SUBMITTER_SALT=change-me
# Reviewer login for /review (HTTP basic auth)
REVIEW_USER=reviewer
REVIEW_PASSWORD=
# Vercel cron secret for /api/cron/poll
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Verify button rate limits (the per-video cost cap is enforced by the pipeline)
# Videos one person can submit per day (default 5)
# SUBMIT_PER_PERSON_PER_DAY=5
# VERIFY_PER_PERSON_PER_DAY=10
# VERIFY_SITE_PER_HOUR=120
