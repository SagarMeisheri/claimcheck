# Local Supabase (supabase start) or your project. These are required; there is no demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pipeline service (Cloud Run)
PIPELINE_URL=http://localhost:8080
PIPELINE_SHARED_SECRET=
# Salt for hashing visitor IPs (rate limits only; rows deleted after 30 days)
SUBMITTER_SALT=change-me
# Reviewer login for /review (reports queue, stop/delete videos; HTTP basic auth)
REVIEW_USER=reviewer
REVIEW_PASSWORD=
# Vercel cron secret for /api/cron/maintenance (daily: refreshes YouTube data, deletes old rate-limit rows)
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the "How it works" and Privacy pages as the contact for reports and data requests
NEXT_PUBLIC_CONTACT_EMAIL=
# Rate limits (0 turns a limit off). The per-video cost cap is enforced by the pipeline.
# SUBMIT_PER_PERSON_PER_DAY=5
# SOURCES_PER_PERSON_PER_DAY=10
# SOURCES_SITE_PER_HOUR=120
# SOURCES_ALL_PER_PERSON_PER_DAY=3
# SOURCES_ALL_SITE_PER_HOUR=20
